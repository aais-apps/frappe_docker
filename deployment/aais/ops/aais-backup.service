[Unit]
Description=AAIS site database, files and configuration backup to encrypted R2
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nirog
Group=nirog
SupplementaryGroups=docker
UMask=0077
ExecStart=/home/nirog/aais-erp/ops/backup.sh
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
